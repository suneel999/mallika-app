# Copy to backend/.env and replace the placeholders. Never commit backend/.env.

DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
DJANGO_LOG_LEVEL=INFO

POSTGRES_DB=mallika
POSTGRES_USER=mallika
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60
POSTGRES_CONNECT_TIMEOUT=5

# Local stand-in for SMS. The API prints each OTP to its own stderr.
# Production refuses this sender. Do not use it on a shared server.
OTP_SENDER=apps.accounts.senders.ConsoleOtpSender
ACCESS_TOKEN_SECONDS=900
REFRESH_TOKEN_DAYS=30
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
OTP_MAX_PER_HOUR=5
