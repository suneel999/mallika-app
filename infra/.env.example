# Copy to infra/.env on the server and replace every placeholder.
# Never commit infra/.env. It holds the database password and the WhatsApp token.

# The name patients and staff use. Its DNS A record must point at this server.
SITE_DOMAIN=app.mallikahospitals.in

DJANGO_SETTINGS_MODULE=config.settings.production
# Make one with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=app.mallikahospitals.in
DJANGO_CORS_ALLOWED_ORIGINS=https://app.mallikahospitals.in
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.mallikahospitals.in
# Caddy serves HTTPS, so plain HTTP requests are sent to HTTPS.
DJANGO_SSL_REDIRECT=true
DJANGO_LOG_LEVEL=INFO

POSTGRES_DB=mallika
POSTGRES_USER=mallika
# Make one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=replace-with-a-long-random-value

# Sign-in codes. Copy these three values from the current live service.
OTP_SENDER=apps.accounts.senders.WhatsAppCloudOtpSender
WHATSAPP_TOKEN=replace-with-the-whatsapp-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-the-phone-number-id
WHATSAPP_TEMPLATE=mallika_otp

# One number that app store reviewers sign in with, and its fixed 6-digit code.
# Nothing is sent to that number. Leave both empty to switch it off.
# Set them with infra/set-review-login.ps1.
REVIEW_MOBILE=
REVIEW_OTP=

# Nightly backups go to this bucket. The server reaches it through its IAM role, not a key.
BACKUP_BUCKET=replace-with-the-bucket-name
